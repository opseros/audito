# --- Database (Neon) -------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/auditmesh?sslmode=require
# Direct connection string, used by migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/auditmesh?sslmode=require

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Encrypts MFA secrets and OAuth state.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Sign-in methods -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (any work/personal account), "organizations", or your tenant id
MICROSOFT_TENANT_ID=common

# --- Cloudflare Turnstile ----------------------------------------------------
# Empty site key = widget off (local development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Resend). Empty = links are printed to the server log. ------------
RESEND_API_KEY=
EMAIL_FROM="AuditMesh <no-reply@yourdomain.com>"

# --- Seed ----------------------------------------------------------------------
# Password for demo accounts created by `npm run db:seed`. Do not seed in production.
SEED_DEMO_PASSWORD=
